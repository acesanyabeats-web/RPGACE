{
  "model": "claude-sonnet-4-6",
  "context_files": [
    "CLAUDE.md"
  ],
  "auto_approve": false,
  "permissions": {
  "allow": [
    "mcp__Supabase__execute_sql",
    "mcp__Supabase__apply_migration"
  ]
},
  "check_commands": [
    "node --check rpgace_core.js"
  ],
  "ignore_paths": [
    "index.html.bak",
    "node_modules",
    ".vercel"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
